# EditorConfig is awesome: https://EditorConfig.org

# 顶层配置文件
root = true

# 所有文件通用
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 文件
[*.md]
trim_trailing_whitespace = false

# 前端文件
[*.{js,ts,jsx,tsx,vue,css,scss,less,html,json}]
indent_size = 2

# YAML / YML
[*.{yml,yaml}]
indent_size = 2

# Shell 脚本
[*.sh]
indent_size = 4
end_of_line = lf

# PowerShell 脚本
[*.ps1]
indent_size = 4
end_of_line = crlf

# Makefile
[Makefile]
indent_style = tab

# 数据库脚本
[*.sql]
indent_size = 2
